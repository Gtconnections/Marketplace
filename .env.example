# ─────────────────────────────────────────────────────────────
#  Marketplace — variables de entorno
#  Copia este archivo a `.env.local` y rellena tus valores.
# ─────────────────────────────────────────────────────────────

# URL pública de la app (sin barra final). En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ──────────────────────────────────────────────────
# Panel de Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key
# Clave de servicio (SECRETA, solo servidor — nunca la expongas al cliente)
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# ── Stripe (cuenta única — todos los pagos entran completos a tu cuenta) ──
# Panel de Stripe → Developers → API keys (usa las de TEST al principio)
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Secretos del webhook (separados por coma si usas varios entornos).
# Ej. local + producción en el mismo .env.local:
#   STRIPE_WEBHOOK_SECRET=whsec_local_del_stripe_listen,whsec_del_endpoint_de_produccion
# - local: el que imprime `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# - producción: el "Signing secret" del endpoint creado en Developers → Webhooks
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── Modo de pagos ─────────────────────────────────────────────────────
# demo   = botón de pago ficticio, sin Stripe (por defecto, para desarrollo).
# stripe = cobros reales con Stripe (una sola cuenta, la tuya).
NEXT_PUBLIC_PAYMENTS_MODE=demo

# ── Administradores ───────────────────────────────────────────────────
# Emails (separados por comas) que pueden publicar servicios. Tienda de un
# solo vendedor por ahora; el resto de usuarios solo compran.
ADMIN_EMAILS=martin@gtconnections.com
